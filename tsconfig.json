{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    // Mantém o preset "strictest", exceto esta flag: ela impede repassar props
    // opcionais entre componentes (`prop={valorTalvezUndefined}`) sem ganho real aqui.
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
