---
/**
 * Hub dos feriados e das temporadas: todos os cartões em ordem cronológica, a partir da data
 * do build (agende builds periódicos para as datas e as ofertas se atualizarem sozinhas).
 */
import CartoesDatasEspeciais from '@/components/sections/CartoesDatasEspeciais.astro';
import Botao from '@/components/ui/Botao.astro';
import Secao from '@/components/ui/Secao.astro';
import { rotas } from '@/data/rotas';
import PaginaLayout from '@/layouts/PaginaLayout.astro';
import { acoes } from '@/lib/acoes';
import { DATA_CONTEUDO } from '@/lib/datas';
import { obterImagem } from '@/lib/imagens';
import { resort } from '@/site.config';

const topo = await obterImagem('grand-oca/piscinas/piscina-solario.jpg');
---

<PaginaLayout rota="datasEspeciais" imagem={topo} atualizadoEm={DATA_CONTEUDO}>
  <Fragment slot="acoes">
    <Botao href={acoes.consultarTarifas.href} variante="verde" tamanho="lg" icone="calendario">
      Consultar tarifas
    </Botao>
    <Botao href={rotas.lazer.caminho} variante="contorno" tamanho="lg">
      Lazer e entretenimento
    </Botao>
  </Fragment>

  <Secao
    titulo={`Quais são os feriados e as datas especiais no ${resort.nome}?`}
    sobretitulo="Calendário"
    introducao={`Feriado prolongado, férias escolares ou uma data para comemorar: escolha o período e garanta a sua estadia all inclusive no ${resort.nomeCurto}, com praia, piscinas, recreação para as crianças e refeições e bebidas selecionadas incluídas.`}
  >
    <CartoesDatasEspeciais nivelTitulo={3} />
  </Secao>
</PaginaLayout>
