---
/**
 * Topo da home: foto em tela cheia (prioritária, é o LCP) com sombras neutras, trilha geográfica
 * (UF › cidade › praia), H1, subtítulo e as duas formas de reserva (slot `acoes`), tudo
 * centralizado. Sobreposta à base da foto, uma faixa branca com a ficha rápida em colunas
 * (localização, regime, praia, acomodações, crianças, central) e, abaixo dela, a resposta direta
 * (slot padrão) e a ressalva da ficha. As entradas são animações de CSS e somem com "menos movimento".
 */
import type { ImageMetadata } from 'astro';

import Icone from '@/components/ui/Icone.astro';
import Imagem from '@/components/ui/Imagem.astro';
import SeloPagamento from '@/components/ui/SeloPagamento.astro';
import type { NomeIcone } from '@/lib/icones';

export interface ItemFicha {
  rotulo: string;
  valor: string;
  icone: NomeIcone;
  /** Link do valor (ex.: telefone da central). */
  href?: string;
}

interface Props {
  titulo: string;
  /** Trilha geográfica acima do título (ex.: ["UF", "Cidade", "Praia"]). */
  trilhaGeografica: readonly string[];
  subtitulo: string;
  imagem: { src: ImageMetadata; alt: string };
  ficha: readonly ItemFicha[];
  /** Observação sob a ficha (ex.: ressalva da gratuidade das crianças, marcada com *). */
  nota?: string;
}

const { titulo, trilhaGeografica, subtitulo, imagem, ficha, nota } = Astro.props;
---

<div class="relative">
  <div class="superficie-escura bg-carvao-950 relative isolate overflow-hidden text-white">
    <div class="container-site flex min-h-[min(86svh,48rem)] flex-col items-center justify-end pt-40 pb-32 text-center sm:pb-36">
      <div class="animate-subir flex max-w-4xl flex-col items-center space-y-5">
        <p class="text-[0.6875rem] font-semibold tracking-[0.12em] text-white/85 uppercase sm:text-xs">
          {trilhaGeografica.join(' › ')}
        </p>
        <h1 class="titulo-pagina text-white [text-shadow:0_2px_18px_rgb(0_0_0/0.55)]">{titulo}</h1>
        <p class="max-w-2xl text-base font-normal text-white [text-shadow:0_1px_3px_rgb(0_0_0/0.75),0_0_18px_rgb(0_0_0/0.5)] sm:text-lg">
          {subtitulo}
        </p>
        {Astro.slots.has('acoes') && (
          <div class="flex flex-wrap justify-center gap-3 pt-2">
            <slot name="acoes" />
          </div>
        )}
        <SeloPagamento
          escuro
          centralizado
          nota="Condições válidas para hospedagem e para o pacote com aéreo."
        />
      </div>
    </div>
    {/* A foto vem depois do texto no HTML (o leitor de tela ouve o título primeiro). */}
    <div class="absolute inset-0 -z-20">
      <Imagem src={imagem.src} alt={imagem.alt} layout="full-width" sizes="100vw" prioridade />
    </div>
    {/* Degradê preto de cima (60%) para baixo (transparente): escurece sem tingir a foto (sem véu azul). */}
    <div
      class="absolute inset-0 -z-10 bg-linear-to-b from-black/60 via-black/30 to-black/0"
      aria-hidden="true"
    ></div>
    {/* Halo escuro suave atrás do texto central: dá leitura ao subtítulo sem escurecer a foto toda. */}
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_45%_at_50%_55%,rgb(0_0_0/0.45),transparent)]"
      aria-hidden="true"
    ></div>
  </div>

  <div class="container-site relative z-10 -mt-20">
    <dl
      class="ring-areia-200 animate-subir grid grid-cols-2 gap-y-6 rounded-grande bg-white px-4 py-6 shadow-flutuante ring-1 [animation-delay:150ms] sm:grid-cols-3 sm:px-6 lg:grid-cols-6 lg:px-2 lg:py-7"
      aria-label="Ficha rápida"
    >
      {/* No <dl>, cada grupo <div> só pode ter <dt> e <dd>: o ícone fica dentro do <dt>. */}
      {ficha.map((item) => (
        <div class="border-areia-200 min-w-0 px-3 text-center lg:border-l lg:px-4 lg:first:border-l-0">
          <dt class="text-mar-800 flex flex-col items-center gap-1.5 text-sm font-semibold">
            <Icone nome={item.icone} class="text-coral-700 size-6 shrink-0" />
            {item.rotulo}
          </dt>
          <dd class="text-tinta-suave mt-1 text-[0.8125rem] leading-snug">
            {item.href ? (
              <a href={item.href} class="text-mar-700 font-semibold" data-evento="clique_telefone">
                {item.valor}
              </a>
            ) : (
              item.valor
            )}
          </dd>
        </div>
      ))}
    </dl>
    {Astro.slots.has('default') && (
      <div class="mt-14 space-y-4 px-1 sm:mt-16 sm:px-3 lg:px-6">
        <slot />
      </div>
    )}
    {/* Ressalva da ficha (o * das crianças), logo abaixo da faixa. */}
    {nota && <p class="text-tinta-suave mt-4 text-center text-xs">{nota}</p>}
  </div>
</div>
