---
/**
 * Barra fixa no rodapé da tela em celulares e tablets, na largura toda: WhatsApp e Ligar como
 * botões de contorno e Reservar como o botão cheio; os três com a mesma largura
 * e altura. O <body> reserva o espaço dela (sem cobrir conteúdo) e o scroll-padding evita que ela
 * esconda o elemento focado (WCAG 2.4.11).
 */
import Icone from '@/components/ui/Icone.astro';
import { acoes } from '@/lib/acoes';

const { whatsapp, ligar, consultarTarifas: reservar } = acoes;
const atalhos = [
  { ...whatsapp, classeIcone: 'text-verde-700' },
  { ...ligar, classeIcone: 'text-mar-700' },
];
---

<nav
  aria-label="Atendimento rápido"
  class="border-areia-200 fixed inset-x-0 bottom-0 z-30 border-t bg-white/95 pb-[env(safe-area-inset-bottom)] shadow-[0_-6px_20px_rgb(6_42_49/0.08)] backdrop-blur-xl [view-transition-name:barra-acoes] lg:hidden"
>
  <ul class="grid h-(--altura-barra-mobile) grid-cols-3 items-center gap-2 px-3 py-2">
    {atalhos.map((item) => (
      <li class="h-full">
        <a
          href={item.href}
          class="text-mar-950 hover:bg-areia-100 flex h-full items-center justify-center gap-1.5 rounded-full text-sm font-semibold no-underline transition-colors"
          data-evento={item.evento}
          target={item.externo ? '_blank' : undefined}
          rel={item.externo ? 'noopener noreferrer' : undefined}
        >
          <Icone nome={item.icone} class:list={['size-4', item.classeIcone]} />
          <span>
            {item.rotuloCurto}
            {item.externo && <span class="sr-only"> (abre em nova aba)</span>}
          </span>
        </a>
      </li>
    ))}
    <li class="h-full">
      <a
        href={reservar.href}
        class="bg-verde-700 hover:bg-verde-800 flex h-full items-center justify-center gap-2 rounded-full text-sm font-semibold text-white no-underline transition-colors"
        data-evento={reservar.evento}
        target={reservar.externo ? '_blank' : undefined}
        rel={reservar.externo ? 'noopener noreferrer' : undefined}
      >
        <Icone nome={reservar.icone} class="size-4" />
        {reservar.rotuloCurto}
        {reservar.externo && <span class="sr-only"> (abre em nova aba)</span>}
      </a>
    </li>
  </ul>
</nav>
