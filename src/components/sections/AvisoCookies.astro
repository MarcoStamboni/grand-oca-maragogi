---
/**
 * Aviso de cookies (LGPD). Só é renderizado com o analytics ativo (BaseLayout testa
 * `analytics.ativo`). Começa escondido; o script (src/scripts/analytics.ts) mostra o aviso
 * quando não há escolha guardada e carrega o Google só depois do consentimento.
 *
 * Dois caminhos, lado a lado e com o mesmo tamanho: "Aceitar" libera a medição; "Configurar"
 * troca o aviso pelas preferências, no mesmo cartão, onde a medição vem desligada e a pessoa
 * decide antes de salvar (salvar com a chave desligada equivale a recusar). "Preferências de
 * cookies", no rodapé, abre direto esse painel, já com a escolha guardada.
 *
 * Não é modal: não prende o foco nem bloqueia a leitura. Sem JavaScript, nada é carregado e o
 * aviso não aparece.
 */
import { rotas } from '@/data/rotas';
import type { ProvedorAnalytics } from '@/lib/analytics';
import { classesBotao } from '@/lib/botoes';
import { site } from '@/site.config';

interface Props {
  provedor: ProvedorAnalytics;
  id: string;
}

const { provedor, id } = Astro.props;
/**
 * Host do site publicado. O script só liga a medição quando a página está nele: assim uma prévia
 * local, um endereço de homologação ou uma cópia do site não mandam visitas para a propriedade
 * do cliente (aconteceu num teste em 24/11/2026).
 */
const hostDoSite = new URL(site.url).hostname;
/** Chave liga/desliga: o trilho e a bolinha seguem o estado do <input> (que fica só para leitores de tela). */
const trilho =
  'relative mt-0.5 inline-flex h-7 w-12 shrink-0 items-center rounded-full bg-areia-300 transition-colors duration-300 ease-suave group-has-[:checked]:bg-verde-700 group-has-[:focus-visible]:ring-2 group-has-[:focus-visible]:ring-mar-700 group-has-[:focus-visible]:ring-offset-2';
const bolinha =
  'ml-1 size-5 rounded-full bg-white shadow transition-transform duration-300 ease-suave group-has-[:checked]:translate-x-5';
---

<section
  hidden
  aria-labelledby="aviso-cookies-titulo"
  class="fixed inset-x-0 bottom-[calc(var(--altura-barra-mobile)+env(safe-area-inset-bottom))] z-40 p-3 lg:bottom-0"
  data-aviso-cookies
  data-provedor={provedor}
  data-id={id}
  data-host={hostDoSite}
>
  <div class="ring-areia-300 container-site max-w-4xl rounded-cartao bg-white p-4 shadow-[0_8px_32px_rgb(6_42_49/0.18)] ring-1 sm:p-5">
    {/* Passo 1: o aviso. */}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center" data-cookies-aviso>
      <div class="space-y-1 text-sm">
        <p id="aviso-cookies-titulo" class="text-mar-950 font-semibold">
          Podemos usar cookies?
        </p>
        <p class="text-tinta-suave">
          Com a sua permissão, usamos cookies para entender como o site é usado.
          <a href={rotas.cookies.caminho}>Política de cookies</a>.
        </p>
      </div>
      <div class="flex shrink-0 gap-3">
        <button type="button" class:list={classesBotao('contorno')} data-cookies-configurar>
          Configurar
        </button>
        <button type="button" class:list={classesBotao('secundario')} data-cookies-aceitar>
          Aceitar
        </button>
      </div>
    </div>

    {/* Passo 2: as preferências, no lugar do aviso. */}
    <div class="space-y-4 text-sm" hidden data-cookies-painel>
      <div class="space-y-1">
        <p id="aviso-cookies-preferencias" class="text-mar-950 font-semibold">
          Preferências de cookies
        </p>
        <p class="text-tinta-suave">
          Escolha o que pode ser usado e salve.{' '}
          <a href={rotas.cookies.caminho}>Política de cookies</a>.
        </p>
      </div>

      <ul class="divide-areia-200 ring-areia-200 divide-y rounded-cartao ring-1">
        <li class="flex items-start justify-between gap-4 p-4">
          <div class="space-y-0.5">
            <p class="text-mar-950 font-semibold">Necessários</p>
            <p class="text-tinta-suave">
              Fazem o site funcionar e guardam a sua escolha sobre cookies.
            </p>
          </div>
          <span class="bg-mar-50 text-mar-800 mt-0.5 shrink-0 rounded-full px-3 py-1 text-xs font-semibold">
            Sempre ativos
          </span>
        </li>
        <li>
          {/* Grade (e não flex) para o texto ficar direto no <label>: é ele que nomeia a chave. */}
          <label class="group grid cursor-pointer grid-cols-[minmax(0,1fr)_auto] items-start gap-x-4 gap-y-0.5 p-4">
            <span class="text-mar-950 font-semibold">Medição de audiência</span>
            <input
              type="checkbox"
              class="sr-only"
              aria-label="Medição de audiência"
              data-cookies-medicao
            />
            <span class={trilho} aria-hidden="true">
              <span class={bolinha}></span>
            </span>
            <span class="text-tinta-suave col-start-1">
              Ajuda a entender como o site é usado, sem publicidade.
            </span>
          </label>
        </li>
      </ul>

      <button type="button" class:list={classesBotao('secundario')} data-cookies-salvar>
        Salvar preferências
      </button>
    </div>
  </div>
</section>

<script>
  import '@/scripts/analytics';
</script>
