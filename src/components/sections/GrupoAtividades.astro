---
/**
 * Cartão que reúne várias atividades parecidas numa imagem só, com "Ler mais" (details) para ver o
 * que o resort oferece em cada uma. Usado quando não há foto de cada atividade.
 */
import Icone from '@/components/ui/Icone.astro';
import Imagem from '@/components/ui/Imagem.astro';
import { type Atividade, textoCobranca, textoHorarioAtividade } from '@/lib/atividades';
import type { NomeIcone } from '@/lib/icones';
import type { ImagemResolvida } from '@/lib/imagens';

interface Props {
  titulo: string;
  resumo: string;
  icone: NomeIcone;
  foto: ImagemResolvida;
  atividades: readonly Atividade[];
}

const { titulo, resumo, icone, foto, atividades } = Astro.props;
const cobranca = atividades[0] ? textoCobranca(atividades[0]) : undefined;
---

<article class="group ring-areia-200 ease-suave flex h-full flex-col overflow-hidden rounded-cartao bg-white ring-1 transition duration-500 hover:-translate-y-1 hover:shadow-flutuante">
  <div class="relative aspect-[16/7] overflow-hidden">
    <Imagem
      src={foto.src}
      alt={foto.alt}
      sizes="(min-width: 768px) 40vw, 100vw"
      largura={800}
      class="ease-suave h-full w-full object-cover transition-transform duration-[1.2s] group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start gap-3">
      <span class="text-coral-700 flex shrink-0 pt-0.5">
        <Icone nome={icone} class="size-6" />
      </span>
      <div class="space-y-1">
        <h3 class="">{titulo}</h3>
        {cobranca && (
          <p class="bg-mar-50 text-mar-700 inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold">
            {cobranca}
          </p>
        )}
      </div>
    </div>
    <p class="text-tinta">{resumo}</p>
    <details class="group/ler mt-auto">
      <summary class="text-coral-700 cursor-pointer font-semibold">
        Ler mais
        <span class="text-tinta-suave text-sm font-normal">({atividades.length} atividades)</span>
      </summary>
      <ul class="mt-3 space-y-3 text-sm">
        {atividades.map((atividade) => {
          const horario = textoHorarioAtividade(atividade);
          return (
            <li id={atividade.id}>
              <strong class="text-mar-950 font-semibold">{atividade.data.nome}</strong>
              <span class="text-tinta block">{atividade.data.resumo}</span>
              {atividade.data.publico && (
                <span class="text-tinta-suave block">Público: {atividade.data.publico}</span>
              )}
              {horario && <span class="text-tinta-suave block">Horário: {horario}</span>}
            </li>
          );
        })}
      </ul>
    </details>
  </div>
</article>
