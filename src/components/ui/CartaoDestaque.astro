---
/**
 * Cartão com ícone ou sobretítulo, título e texto (ex.: "Antes de viajar": ENTRADA · Check-in a
 * partir das 15h, como no Grand Oca). Com `href`, o cartão inteiro vira link (título como link
 * acessível). Com `foto`, uma faixa de imagem abre o cartão.
 */
import Icone from '@/components/ui/Icone.astro';
import Imagem from '@/components/ui/Imagem.astro';
import { iconeDoTexto } from '@/lib/icone-do-texto';
import type { NomeIcone } from '@/lib/icones';
import type { ImagemResolvida } from '@/lib/imagens';

interface Props {
  titulo: string;
  /** Texto curto em caixa alta acima do título (ex.: "Entrada"). */
  sobretitulo?: string;
  icone?: NomeIcone;
  href?: string;
  foto?: ImagemResolvida;
  nivelTitulo?: 2 | 3;
  class?: string;
}

const { titulo, sobretitulo, icone, href, foto, nivelTitulo = 3, class: classe } = Astro.props;
const Titulo = `h${nivelTitulo}` as const;
/** Sem ícone próprio, o título ganha ao lado o ícone que faz referência a ele. */
const iconeDoTitulo = icone ? null : iconeDoTexto(titulo, null);
---

<div class:list={['h-full', classe]} data-revelar>
  <div
    class:list={[
      'group relative flex h-full flex-col overflow-hidden rounded-cartao bg-white shadow-cartao ring-1 ring-black/8 ease-suave transition duration-500 hover:-translate-y-1 hover:shadow-flutuante',
      href && 'focus-within:ring-mar-700 focus-within:ring-3',
    ]}
  >
    {foto && (
      <div class="aspect-16/9 overflow-hidden">
        <Imagem
          src={foto.src}
          alt={foto.alt}
          sizes="(min-width: 1024px) 26rem, (min-width: 640px) 50vw, 100vw"
          largura={800}
          class="ease-suave h-full w-full object-cover transition-transform duration-[1.2s] group-hover:scale-105"
        />
      </div>
    )}
    <div class="flex flex-1 flex-col gap-2.5 p-6">
      {icone && (
        <span class="text-mar-700 ease-suave flex transition-transform duration-500 group-hover:-rotate-6">
          <Icone nome={icone} class="size-7" />
        </span>
      )}
      {sobretitulo && <p class="sobretitulo">{sobretitulo}</p>}
      <Titulo class:list={['', iconeDoTitulo && 'flex items-start gap-2']}>
        {iconeDoTitulo && (
          <Icone nome={iconeDoTitulo} class="text-coral-700 mt-0.5 size-5 shrink-0" />
        )}
        {href ? (
          <a href={href} class="text-mar-800 link-esticado no-underline focus-visible:outline-none">
            {titulo}
          </a>
        ) : (
          titulo
        )}
      </Titulo>
      <div class="text-tinta-suave space-y-2 text-[0.9375rem]">
        <slot />
      </div>
    </div>
  </div>
</div>
