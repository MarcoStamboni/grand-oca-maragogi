# Copie para .env (ou configure no painel do servidor de deploy) e preencha.
# Nunca faça commit do .env. Todos os valores abaixo são públicos (vão para o HTML).
# Depois de mudar qualquer valor, gere o site de novo (npm run build).

# Endpoint que recebe o formulário de cotação/contato (/contato/, /reservas/hospedagem/ e
# /reservas/pacote-com-aereo/). Precisa aceitar POST com FormData e responder 2xx; com
# JavaScript desligado, o navegador envia direto para ele. Ex.: https://formspree.io/f/<id>
# (o campo-armadilha "_gotcha" já segue o padrão do Formspree), Web3Forms ou API própria.
# Vazio = sem formulário: as páginas mostram só os canais de atendimento.
PUBLIC_FORM_ENDPOINT=

# Perfil do viajante (janela do motor de reservas): ao clicar em Enviar, o site manda um POST
# JSON em segundo plano para este endereço e segue para a disponibilidade do motor. O serviço
# (Make, Zapier, n8n ou provedor de WhatsApp Business API) repassa a mensagem aos consultores
# no WhatsApp da agência. O JSON traz o campo "mensagem", já formatado para o WhatsApp.
# Vazio = modo teste: os dados ficam só no navegador (localStorage "summerville-leads-teste").
PUBLIC_LEADS_WEBHOOK=

# Medição de audiência: o código de produção fica em src/site.config.ts (`medicao`) e liga
# sozinho, preso ao domínio do site. Use as variáveis abaixo só para testar outro código: com
# algum ID aqui, vale o .env (e PUBLIC_ANALYTICS_ENABLED=true). O Google só carrega depois do
# consentimento no aviso de cookies (LGPD). Com os dois IDs, vale o GTM. ID em formato inválido
# derruba o build.
# No GTM, publique só tags de medição de audiência: o aviso não pede consentimento para
# publicidade (o Consent Mode envia publicidade como negada).
PUBLIC_ANALYTICS_ENABLED=false
# Formato G-XXXXXXXXXX
PUBLIC_GA4_ID=
# Formato GTM-XXXXXXX
PUBLIC_GTM_ID=
